{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "booking": {
        "ClusterId": "booking-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "seat-hub": {
        "ClusterId": "booking-api",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "booking-api": {
        "Destinations": {
          "d1": {
            "Address": "http://booking-api:8080"
          }
        }
      }
    }
  }
}
