{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 100000,
      "MaxConcurrentUpgradedConnections": 100000
    },
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ticketing;Username=ticketing;Password=ticketing",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },

  "SeatLock": {
    "TtlMinutes": 10,
    "PaymentExtensionMinutes": 5
  },

  "TokenBucket": {
    "BucketSize": 10000,
    "RefillRatePerSecond": 500
  },

  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "booking-api"
  }
}
